# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/google/callback

# Supabase
SUPABASE_URL=https://your-project.supabase.co
